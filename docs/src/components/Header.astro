---
import Search from '@astrojs/starlight/components/Search.astro';
import ScryrLogo from './ScryrLogo.astro';
import PageMenu from './PageMenu.astro';
const { siteTitleHref } = Astro.locals.starlightRoute;
const links = [
  { label: 'The Method', href: '/why/', icon: 'M4 4h16v12H4zM12 16v5m-4 0 4-5 4 5' },
  { label: 'Open Source', href: '/getting-started/', icon: 'M12 3v12m-5-5 5 5 5-5M4 16v5h16v-5' },
  { label: 'Docs', href: '/manifests/', icon: 'M12 5v16M12 5C9 3 5 3 2 4v15c3-1 7-1 10 2 3-3 7-3 10-2V4c-3-1-7-1-10 1Z' },
  { label: 'App Login', href: 'https://scryr.app', icon: 'M3 3h7v7H3V3Zm11 0h7v7h-7V3ZM3 14h7v7H3v-7Zm11 0h7v7h-7v-7Z' },
  { label: 'Github', href: 'https://github.com/scryr-app/scryr-dev', icon: 'M15 22v-4a4.8 4.8 0 0 0-1-3.5c3.3-.4 6.8-1.6 6.8-7A5.4 5.4 0 0 0 19.4 4 5 5 0 0 0 19.3.5S18.2.1 15 1.8a13.4 13.4 0 0 0-6 0C5.8.1 4.7.5 4.7.5A5 5 0 0 0 4.6 4a5.4 5.4 0 0 0-1.4 3.7c0 5.3 3.5 6.5 6.8 7-.5.4-.8 1-.9 1.6-.8.4-2.9 1.1-4.1-1.2A3.3 3.3 0 0 0 2.6 13c-1.5 0-.1.9-.1.9a2.6 2.6 0 0 1 1.8 1.2 2.8 2.8 0 0 0 3.9 1.1c0 .6.3 1.6.3 1.8v4' },
];
---
<div class="scryr-toolbar">
  <PageMenu />
  <a class="toolbar-brand" href={siteTitleHref} aria-label="Scryr home"><span class="toolbar-mark"><ScryrLogo /></span><span class="toolbar-wordmark">Scryr</span></a>
  <div class="toolbar-search"><Search /></div>
  <div class="toolbar-actions">
  <div class="toolbar-desktop">
    <nav aria-label="Main navigation">{links.map(link => <a href={link.href}><svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={link.icon} /></svg>{link.label}</a>)}</nav>
  </div>
  <details class="toolbar-menu">
    <summary>Links <span aria-hidden="true"><svg viewBox="0 0 12 12"><path d="m2.5 4.5 3.5 3 3.5-3" /></svg></span></summary>
    <nav aria-label="Main navigation">{links.map(link => <a href={link.href}><svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={link.icon} /></svg>{link.label}</a>)}</nav>
  </details>
  </div>
</div>

<style>
  .scryr-toolbar { position: relative; display: flex; align-items: center; gap: .5rem; height: 100%; white-space: nowrap; }
  .toolbar-brand { display: inline-flex; align-items: center; gap: .6rem; color: #f5edff; text-decoration: none; padding-inline: .2rem; }
  .toolbar-mark { --mark-size: 30px; display: block; }
  .toolbar-mark :global(.scryr-logo i) { display: none; }
  .toolbar-wordmark { font-family: 'Cinzel Decorative', Georgia, serif; font-weight: 400; font-size: 1.6rem; letter-spacing: -.065em; line-height: 1.15; text-shadow: var(--scryr-title-shadow); }
  .toolbar-search { position: absolute; left: 50%; top: 50%; display: flex; transform: translate(-50%, -50%); }
  .toolbar-search :global(site-search) { display: block; width: clamp(13rem, 20vw, 20rem); }
  .toolbar-search :global(button[data-open-modal]) { width: 100%; max-width: none; }
  .toolbar-desktop, .toolbar-desktop nav { display: flex; align-items: center; gap: .2rem; }
  .toolbar-actions { display: flex; align-items: center; gap: .35rem; margin-left: auto; white-space: nowrap; }
  nav a { color: #d5c8df; font-size: var(--sl-text-sm); font-weight: 500; text-decoration: none; white-space: nowrap; gap: .3rem; }
  .nav-icon { width: .78rem; height: .78rem; flex: none; color: currentColor; }
  .toolbar-desktop nav a { display: inline-flex; align-items: center; justify-content: center; min-height: 1.8rem; padding: .25rem .42rem; border-radius: .25rem; transition: color .2s, background .2s; }
  .toolbar-desktop nav a:hover { background: #b789e50d; color: #fff; }
  nav a:hover { color: #fff; }
  a:focus-visible, summary:focus-visible { outline: 2px solid #e7c77c; outline-offset: 5px; }
  .toolbar-menu { display: none; position: relative; }
  summary { display: inline-flex; align-items: center; list-style: none; color: #f5edff; cursor: pointer; font-size: .75rem; padding: .3rem .6rem; border: 1px solid #b58cda30; border-radius: .3rem; background: #ffffff04; }
  summary::-webkit-details-marker { display: none; }
  summary span { display: inline-flex; align-items: center; margin-left: .4rem; }
  summary span svg { display: block; width: .75rem; height: .75rem; fill: none; stroke: currentColor; stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; }
  .toolbar-menu nav { position: absolute; right: 0; top: calc(100% + .75rem); display: grid; gap: .25rem; min-width: 12rem; padding: .65rem; border: 1px solid #b788df55; border-radius: .4rem; background: #10091c; box-shadow: 0 1rem 3rem #0008; }
  .toolbar-menu nav a { display: flex; align-items: center; padding: .65rem; border-radius: .2rem; }
  .toolbar-menu nav a:hover { background: #b789e51a; }
  @media (max-width: 1099px) {
    .toolbar-search { position: static; order: 2; flex: none; transform: none; }
    .toolbar-actions { order: 1; }
    .toolbar-search :global(site-search) { width: 2rem; }
    .toolbar-search :global(button[data-open-modal]) { display: flex; align-items: center; justify-content: center; width: 2rem; height: 2rem; padding: .35rem; border: 0; background: transparent; box-shadow: none; }
    .toolbar-search :global(button[data-open-modal] > span),
    .toolbar-search :global(button[data-open-modal] > kbd) { display: none !important; }
  }
  @media (max-width: 640px) { .toolbar-desktop { display: none; } .toolbar-menu { display: block; } .toolbar-actions { gap: .35rem; } }
  @media (max-width: 420px) { .toolbar-wordmark { display: none; } }
</style>
