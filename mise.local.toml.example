# Copy to mise.local.toml. Use separate development cloud resources.
[env]
TURSO_DATABASE_URL = "libsql://your-dev-database.turso.io"
TURSO_AUTH_TOKEN = ""
CLERK_SECRET_KEY = ""
VITE_CLERK_PUBLISHABLE_KEY = ""
CLOUD_GRAPHQL_URL = "https://your-fly-app.fly.dev/graphql"
FLY_APP = "your-fly-app"
FLY_API_TOKEN = ""
CORS_ALLOWED_ORIGINS = "http://127.0.0.1:3000,https://your-project.vercel.app"
VERCEL_TOKEN = ""
VERCEL_ORG_ID = ""
VERCEL_PROJECT_ID = ""
# Release and distribution (only needed by maintainers):
# Set RELEASE_TAG=vX.Y.Z in your shell for each release or deployment.
GH_REPO = "scryr-app/scryr-dev"
GH_TOKEN = ""
HOMEBREW_TAP = "scryr-app/homebrew-tap"
HOMEBREW_TAP_TOKEN = ""
