"""Remote workflow evidence belongs to Repository; local checks stay separate."""

from scryr import Diagram, Info, Manifest
from scryr.collectors import (
    GitHubActionsCollector,
    GitHubPullRequestCollector,
    GitStatusCollector,
    RuffCheckCollector,
    Schedule,
)

api = Manifest(
    manifest_id="github-actions/api",
    name="API",
    info=Info(description="Local checkout context and remote CI, each with its own provenance."),
    repository=[
        GitStatusCollector(),
        GitHubPullRequestCollector(repository="example/api", schedule=Schedule(manual=True)),
        GitHubActionsCollector(
            repository="example/api",
            workflow="ci.yml",
            branch="main",
            schedule=Schedule(manual=True),
        ),
    ],
    checks=[RuffCheckCollector()],
)
workflow_diagram = Diagram(name="GitHub Actions", manifests=[api])
