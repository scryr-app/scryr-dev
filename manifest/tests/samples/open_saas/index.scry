email_block = Manifest(
    name="Email",
    icon="✉️",
    classification=Classification.public_api,
    tags=["email", "transactional", "auth"],
    connections=[],
    info=Info(
        description=Markdown(
            "## Account email\n"
            "\n"
            "Transactional email service (SendGrid or Mailgun, configurable via Wasp `emailSender`). Sends email verification links on sign-up, password reset emails, and any custom workflow emails triggered by server actions.\n"
            "\n"
            "> **Illustrative sample notes:** the checks below are design and runbook examples, not claims about an active deployment.\n"
