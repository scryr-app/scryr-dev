"""OpenTelemetry Astronomy Shop Demo manifest.

A polyglot microservice e-commerce demo illustrating OpenTelemetry
instrumentation across many languages and runtimes.

Architecture reference: https://opentelemetry.io/docs/demo/architecture/
Source: https://github.com/open-telemetry/opentelemetry-demo
"""

from scryr import Diagram, Manifest
from scryr.saas import Classification

kafka_block = Manifest(
    name="Kafka",
    icon="📨",
    classification=Classification.queue,
    tags=["messaging", "async", "infra"],
    connections=[],
)
valkey_block = Manifest(
    name="Valkey",
    icon="🗄️",
    classification=Classification.cache_store,
    tags=["cache", "infra"],
    connections=[],
)
postgres_block = Manifest(
    name="PostgreSQL",
    icon="🐘",
    classification=Classification.database,
    tags=["database", "sql", "infra"],
    connections=[],
)
flagd_block = Manifest(
    name="Flagd",
    icon="🚩",
    classification=Classification.internal_api,
    tags=["feature-flags", "infra"],
    connections=[],
)
accounting_block = Manifest(
    name="Accounting",
    icon="🧾",
    classification=Classification.worker,
    tags=["orders", "finance"],
    connections=[Manifest(name="Kafka"), Manifest(name="PostgreSQL")],
)
ad_block = Manifest(
    name="Ad",
    icon="📢",
    classification=Classification.internal_api,
    tags=["ads", "recommendations"],
    connections=[Manifest(name="Flagd")],
)
cart_block = Manifest(
    name="Cart",
    icon="🛒",
    classification=Classification.internal_api,
    tags=["cart", "shopping"],
    connections=[Manifest(name="Valkey"), Manifest(name="Flagd")],
)
checkout_block = Manifest(
    name="Checkout",
    icon="💳",
    classification=Classification.internal_api,
    tags=["checkout", "orders", "orchestration"],
    connections=[
        Manifest(name="Cart"),
        Manifest(name="Currency"),
        Manifest(name="Email"),
        Manifest(name="Payment"),
        Manifest(name="Product Catalog"),
        Manifest(name="Shipping"),
        Manifest(name="Kafka"),
    ],
)
currency_block = Manifest(
    name="Currency",
    icon="💱",
    classification=Classification.internal_api,
    tags=["currency", "finance"],
    connections=[],
)
email_block = Manifest(
    name="Email",
    icon="✉️",
    classification=Classification.internal_api,
    tags=["email", "notifications"],
    connections=[],
)
flagd_ui_block = Manifest(
    name="Flagd-UI",
    icon="🎛️",
    classification=Classification.admin_ui,
    tags=["feature-flags", "admin"],
    connections=[Manifest(name="Flagd")],
)
fraud_detection_block = Manifest(
    name="Fraud Detection",
    icon="🕵️",
    classification=Classification.worker,
    tags=["fraud", "risk", "async"],
    connections=[Manifest(name="Kafka")],
)
image_provider_block = Manifest(
    name="Image Provider",
    icon="🖼️",
    classification=Classification.object_storage,
    tags=["assets", "static", "images"],
    connections=[],
)
payment_block = Manifest(
    name="Payment",
    icon="💰",
    classification=Classification.internal_api,
    tags=["payments", "billing"],
    connections=[Manifest(name="Flagd")],
)
product_catalog_block = Manifest(
    name="Product Catalog",
    icon="📦",
    classification=Classification.internal_api,
    tags=["products", "catalog"],
    connections=[Manifest(name="Flagd")],
)
product_reviews_block = Manifest(
    name="Product Reviews",
    icon="⭐",
    classification=Classification.internal_api,
    tags=["reviews", "genai", "llm"],
    connections=[],
)
quote_block = Manifest(
    name="Quote",
    icon="📬",
    classification=Classification.internal_api,
    tags=["shipping", "quotes", "pricing"],
    connections=[],
)
recommendation_block = Manifest(
    name="Recommendation",
    icon="👍",
    classification=Classification.internal_api,
    tags=["recommendations", "personalization"],
    connections=[Manifest(name="Product Catalog")],
)
shipping_block = Manifest(
    name="Shipping",
    icon="🚚",
    classification=Classification.internal_api,
    tags=["shipping", "logistics"],
    connections=[Manifest(name="Quote")],
)
frontend_block = Manifest(
    name="Frontend",
    icon="🌐",
    classification=Classification.public_ui,
    tags=["web", "storefront", "ui"],
    connections=[
        Manifest(name="Ad"),
        Manifest(name="Cart"),
        Manifest(name="Checkout"),
        Manifest(name="Currency"),
        Manifest(name="Product Catalog"),
        Manifest(name="Recommendation"),
        Manifest(name="Shipping"),
        Manifest(name="Product Reviews"),
    ],
)
frontend_proxy_block = Manifest(
    name="Frontend Proxy",
    icon="🔀",
    classification=Classification.network_gateway,
    tags=["proxy", "ingress", "envoy"],
    connections=[
        Manifest(name="Frontend"),
        Manifest(name="Flagd-UI"),
        Manifest(name="Image Provider"),
    ],
)
load_generator_block = Manifest(
    name="Load Generator",
    icon="⚡",
    classification=Classification.worker,
    tags=["testing", "load", "simulation"],
    connections=[Manifest(name="Frontend Proxy")],
)
react_native_app_block = Manifest(
    name="React Native App",
    icon="📱",
    classification=Classification.mobile_app,
    tags=["mobile", "react-native", "ui"],
    connections=[Manifest(name="Frontend Proxy")],
)

otel_demo_diagram = Diagram(
    name="OpenTelemetry Demo",
    manifests=[
        kafka_block,
        valkey_block,
        postgres_block,
        flagd_block,
        accounting_block,
        ad_block,
        cart_block,
        checkout_block,
        currency_block,
        email_block,
        flagd_ui_block,
        fraud_detection_block,
        image_provider_block,
        payment_block,
        product_catalog_block,
        product_reviews_block,
        quote_block,
        recommendation_block,
        shipping_block,
        frontend_block,
        frontend_proxy_block,
        load_generator_block,
        react_native_app_block,
    ],
)

otel_demo_checkout_flow_diagram = Diagram(
    name="OpenTelemetry Checkout Flow",
    manifests=[
        frontend_block,
        frontend_proxy_block,
        cart_block,
        checkout_block,
        product_catalog_block,
        currency_block,
        payment_block,
        shipping_block,
        email_block,
        kafka_block,
    ],
)
