{
	"name": "map",
	"version": "0.7.1",
	"private": true,
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/scryr-app/scryr-dev.git",
		"directory": "map"
	},
	"type": "module",
	"scripts": {
		"test:editor": "vp exec playwright test",
		"codegen": "vp exec graphql-codegen --config codegen.yml",
		"codegen:watch": "vp exec graphql-codegen --config codegen.yml --watch",
		"predev": "vp exec node scripts/sync-browser-sdk.mjs",
		"dev": "vp dev --port 3000",
		"prebuild": "vp exec node scripts/check-hosted-config.mjs && vp exec node scripts/sync-browser-sdk.mjs",
		"build": "vp build && vp check --no-fmt --no-lint",
		"serve": "vp preview",
		"test": "vp test run",
		"format": "vp fmt",
		"lint": "vp lint",
		"check": "vp check",
		"format:check": "vp fmt --check",
		"fix": "vp check --fix",
		"typecheck": "vp check --no-fmt --no-lint"
	},
	"dependencies": {
		"@clerk/react": "^6.15.1",
		"@codemirror/autocomplete": "^6.20.3",
		"@codemirror/commands": "^6.10.3",
		"@codemirror/lang-python": "^6.2.1",
		"@codemirror/language": "^6.12.3",
		"@codemirror/state": "^6.7.4",
		"@codemirror/theme-one-dark": "^6.1.3",
		"@codemirror/view": "^6.43.11",
		"@lezer/highlight": "^1.2.3",
		"@react-three/drei": "^10.7.7",
		"@react-three/fiber": "^9.6.1",
		"@react-three/uikit": "^1.0.76",
		"@react-three/uikit-lucide": "^1.0.76",
		"@tanstack/react-devtools": "^0.10.5",
		"@tanstack/react-query": "^5.102.8",
		"@tanstack/react-query-devtools": "^5.102.8",
		"@tanstack/react-router": "^1.170.33",
		"@tanstack/react-router-devtools": "^1.167.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"elkjs": "^0.12.0",
		"graphql": "^16.14.2",
		"graphql-request": "^7.4.0",
		"lucide-react": "^1.41.0",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"three": "^0.185.1",
		"three-stdlib": "^2.36.1",
		"web-worker": "^1.5.0"
	},
	"devDependencies": {
		"@graphql-codegen/add": "^7.1.0",
		"@graphql-codegen/cli": "^7.4.6",
		"@graphql-codegen/typescript-react-query": "^7.0.1",
		"@graphql-typed-document-node/core": "^3.2.0",
		"@playwright/test": "^1.63.0",
		"@tanstack/devtools-vite": "^0.8.5",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^26.4.1",
		"@types/react": "^19.2.15",
		"@types/react-dom": "^19.2.7",
		"@types/three": "^0.185.4",
		"@vitejs/plugin-react": "^6.1.1",
		"babel-plugin-react-compiler": "^1.0.0",
		"jsdom": "^30.0.1",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
		"vite-plus": "1.3.0"
	},
	"overrides": {
		"vite": "npm:@voidzero-dev/vite-plus-core@1.3.0"
	},
	"engines": {
		"node": "^24.11.0 || >=26.0.0"
	}
