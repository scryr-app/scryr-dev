{
	"name": "map",
	"version": "0.7.1",
	"private": true,
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/scryr-app/scryr-dev.git",
		"directory": "map"
	},
	"type": "module",
	"scripts": {
		"test:editor": "vp exec playwright test editor.e2e.ts",
		"test:cards": "vp exec playwright test cards.e2e.ts",
		"codegen": "vp exec graphql-codegen --config codegen.yml",
		"codegen:watch": "vp exec graphql-codegen --config codegen.yml --watch",
		"predev": "vp exec node scripts/sync-browser-sdk.mjs",
		"dev": "vp dev --port 3000",
		"prebuild": "vp exec node scripts/check-hosted-config.mjs && vp exec node scripts/sync-browser-sdk.mjs",
		"build": "vp build && vp check --no-fmt --no-lint",
		"serve": "vp preview",
		"test": "vp test run",
		"format": "vp fmt",
		"lint": "vp lint",
		"check": "vp check",
		"format:check": "vp fmt --check",
		"fix": "vp check --fix",
		"typecheck": "vp check --no-fmt --no-lint"
	},
	"dependencies": {
		"@clerk/react": "^6.18.2",
		"@codemirror/autocomplete": "^6.20.4",
		"@codemirror/commands": "^6.11.1",
		"@codemirror/lang-python": "^6.2.1",
		"@codemirror/language": "^6.13.1",
		"@codemirror/state": "^6.7.6",
		"@codemirror/theme-one-dark": "^6.1.3",
		"@codemirror/view": "^6.43.15",
		"@lezer/highlight": "^1.2.5",
		"@react-three/drei": "^10.7.9",
		"@react-three/fiber": "^9.8.2",
		"@tanstack/react-devtools": "^0.10.13",
		"@tanstack/react-query": "^5.105.0",
		"@tanstack/react-query-devtools": "^5.105.0",
		"@tanstack/react-router": "^1.170.46",
		"@tanstack/react-router-devtools": "^1.167.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"elkjs": "^0.12.0",
		"graphql": "^16.14.2",
		"graphql-request": "^7.4.0",
		"lucide-react": "^1.61.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-markdown": "^10.1.0",
		"remark-gfm": "^4.0.1",
		"three": "^0.186.1",
		"three-stdlib": "^2.36.1",
		"web-worker": "^1.5.0"
	},
	"devDependencies": {
		"@graphql-codegen/add": "^7.1.1",
		"@graphql-codegen/cli": "^7.4.6",
		"@graphql-codegen/typescript-react-query": "^7.0.5",
		"@graphql-typed-document-node/core": "^3.2.0",
		"@playwright/test": "^1.64.1",
		"@tanstack/devtools-vite": "^0.8.5",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/three": "^0.186.0",
		"@vitejs/plugin-react": "^6.1.2",
		"babel-plugin-react-compiler": "^1.0.0",
		"jsdom": "^30.1.3",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
		"vite-plus": "1.4.0"
	},
	"overrides": {
		"vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
	},
	"engines": {
		"node": "^24.11.0 || >=26.0.0"
	}
