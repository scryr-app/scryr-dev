"""Browser-runner sample architecture."""

from scryr import Diagram, Manifest



react_block = Manifest(name='React', icon='🌐', tags=['user_interface'], connections=[Manifest(name='Express')])

redis_pubsub_block = Manifest(name='Redis Pub/Sub', icon='📡', tags=['user_interface'], connections=[Manifest(name='Express'), Manifest(name='React')])

express_block = Manifest(name='Express', connections=[Manifest(name='MongoDB')])

mongo_block = Manifest(name='MongoDB', connections=[Manifest(name='Express'), Manifest(name='React')])

angularjs_admin_block = Manifest(name='AngularJS Admin Console', icon='🛠️', connections=[Manifest(name='Express')])

diagram = Diagram(name='MERN', manifests=[react_block, redis_pubsub_block, express_block, mongo_block, angularjs_admin_block])

customer_path = Diagram(name='MERN Customer Path', manifests=[react_block, express_block, mongo_block])

operability = Diagram(name='MERN Operability', manifests=[redis_pubsub_block, express_block, mongo_block])
