"""Browser-runner MERN sample manifest."""

from scryr import Diagram, Info, Link, Manifest
from scryr.types import (
    AuthType,
    Classification,
    DeploymentTarget,
    IaCToolType,
    LogAggregationType,
    Markdown,
    MonitoringType,
    ProgrammingLanguage,
    SemVer,
    TracingType,
    Url,
    WebFramework,
)

# Full type hints and autocomplete! IDE knows all parameter types
react_block = Manifest(
    name="React",
    classification=Classification.public_ui,
    icon="🌐",
    tags=["user_interface"],
    connections=[Manifest(name="Express")],
    info=Info(
        description=(
            "A sample MERN-style application: MongoDB datastore, Express backend, "
            "React frontend. Boy Howdy"
        ),
        version=SemVer("0.1.0-alpha.1"),
        language=ProgrammingLanguage.javascript,
        frameworks=[WebFramework.express, WebFramework.nextjs],
        deployment=DeploymentTarget.ec2,
        owner_team="Frontend Team",
        auth_type=AuthType.oauth2,
        monitoring=MonitoringType.datadog,
        log_aggregation=LogAggregationType.cloudwatch,
        tracing=TracingType.datadog,
        iac_tool=IaCToolType.terraform,
        links=[Link(site_name="Example Site", http_url=Url("https://www.example.com"))],
        docs=["https://www.mongodb.com/docs/", "https://expressjs.com/", "https://reactjs.org/"],
    ),
)
redis_pubsub_block = Manifest(
    name="Redis Pub/Sub",
    classification=Classification.queue,
    icon="📡",
    tags=["user_interface"],
    connections=[Manifest(name="Express"), Manifest(name="React")],
    info=Info(
        description="Redis configured for real-time messaging and event streaming",
        version=SemVer("7.2.0"),
        language=ProgrammingLanguage.c,
        deployment=DeploymentTarget.ec2,
        owner_team="Events Team",
        auth_type=AuthType.api_key,
        monitoring=MonitoringType.prometheus,
        log_aggregation=LogAggregationType.elk_stack,
        tracing=TracingType.jaeger,
        iac_tool=IaCToolType.terraform,
        links=[
            Link(
                site_name="Redis Pub/Sub Documentation",
                http_url=Url("https://redis.io/docs/manual/pubsub/"),
            )
        ],
        docs=["https://redis.io/docs/latest/", "https://redis.io/docs/latest/apis/"],
    ),
)
express_block = Manifest(
    name="Express",
    classification=Classification.internal_api,
    connections=[Manifest(name="MongoDB")],
    info=Info(
        description=Markdown(
            "**Backend API** for customer accounts and application data.\n\n"
            "- Validates requests and persists records in MongoDB\n"
            "- Publishes live updates through Redis\n\n"
            "| Endpoint | Purpose |\n"
            "| --- | --- |\n"
            "| `GET /health` | Readiness check |\n"
            "| `GET /customers` | Customer records |\n\n"
            "- [x] Request validation\n"
            "- [ ] Rate-limit rollout\n\n"
            "> Coordinate schema changes with the frontend team.\n\n"
            "See the [API guide](https://api.example.com/docs)."
        ),
        version=SemVer("1.4.2"),
        language=ProgrammingLanguage.javascript,
        frameworks=[WebFramework.express],
        deployment=DeploymentTarget.amplify,
        owner_team="Backend Team",
        auth_type=AuthType.jwt,
        monitoring=MonitoringType.prometheus,
        log_aggregation=LogAggregationType.elk_stack,
        tracing=TracingType.jaeger,
        iac_tool=IaCToolType.cloudformation,
        links=[
            Link(site_name="API Explorer", http_url=Url("https://api.example.com/docs")),
            Link(site_name="API Health", http_url=Url("https://api.example.com/health")),
        ],
        docs=["https://expressjs.com/", "https://docs.example.com/runbooks/backend"],
    ),
)
mongo_block = Manifest(
    name="MongoDB",
    classification=Classification.database,
    connections=[Manifest(name="Express"), Manifest(name="React")],
    info=Info(
        description=(
            "Primary document store for customer profiles and application records. "
            "The sample deployment uses a replica set with scheduled backups."
        ),
        version=SemVer("7.0.12"),
        language=ProgrammingLanguage.cpp,
        deployment=DeploymentTarget.ec2,
        frameworks=[WebFramework.nextjs],
        owner_team="Data Team",
        auth_type=AuthType.basic,
        monitoring=MonitoringType.cloudwatch,
        log_aggregation=LogAggregationType.cloudwatch,
        tracing=TracingType.aws_xray,
        iac_tool=IaCToolType.terraform,
        links=[
            Link(
                site_name="Database Dashboard",
                http_url=Url("https://monitoring.example.com/mongodb"),
            ),
            Link(
                site_name="Backup Runbook",
                http_url=Url("https://docs.example.com/runbooks/database-backups"),
            ),
        ],
        docs=["https://www.mongodb.com/docs/"],
    ),
)
# Legacy AngularJS admin console (static site)
angularjs_admin_block = Manifest(
    name="AngularJS Admin Console",
    classification=Classification.admin_ui,
    icon="🛠️",
    connections=[Manifest(name="Express")],
    info=Info(
        description="Legacy AngularJS-based admin console for operational management",
        version=SemVer("1.7.9"),
        language=ProgrammingLanguage.javascript,
        deployment=DeploymentTarget.cloudfront,
        owner_team="Ops Team",
        auth_type=AuthType.basic,
        monitoring=MonitoringType.cloudwatch,
        log_aggregation=LogAggregationType.elk_stack,
        tracing=TracingType.none,
        iac_tool=IaCToolType.cloudformation,
        links=[Link(site_name="Admin Portal", http_url=Url("https://admin.example.com"))],
        docs=["https://docs.angularjs.org/"],
    ),
)

diagram = Diagram(
    name="MERN",
    manifests=[
        react_block,
        redis_pubsub_block,
        express_block,
        mongo_block,
        angularjs_admin_block,
    ],
)

customer_path = Diagram(
    name="MERN Customer Path",
    manifests=[react_block, express_block, mongo_block],
)

operability = Diagram(
    name="MERN Operability",
    manifests=[redis_pubsub_block, express_block, mongo_block],
)
